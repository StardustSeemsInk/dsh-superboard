{
  "name": "dsh-superboard",
  "version": "0.0.1",
  "private": true,
  "description": "Agent-editable board for DeepSeek Harness — the canvas replaces the conversation box as the primary UI surface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StardustSeemsInk/dsh-superboard.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "canvas",
    "board"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "vendor",
    "cordis.patch.yml"
  ],
  "scripts": {
    "vendor:mermaid": "node scripts/vendor-mermaid.mjs",
    "vendor:pdfjs": "node scripts/vendor-pdfjs.mjs",
    "vendor": "npm run vendor:mermaid && npm run vendor:pdfjs",
    "test": "node --test \"test/**/*.test.js\"",
    "verify": "node --test \"test/**/*.test.js\" && node -e \"import('dsh-superboard').then(m => { if (typeof m.apply !== 'function') throw new Error('host half does not export apply()'); console.log('host half ok, exports:', Object.keys(m).join(', ')) })\""
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "mermaid": "11.17.2",
    "pdfjs-dist": "6.3.289"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
