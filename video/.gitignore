# Derived artifacts. Everything here is reproduced by `npm run build`.
#
# The frame cache is the big one: ~1.8 GB and ~19 minutes of headless-Edge
# screenshots at 2x supersampling. It is deliberately NOT committed, so
# `npm run build` re-captures from the scenes rather than reusing frames
# nobody can inspect in a diff.
.frames/
.segments/
.determinism/

# The score is generated by audio/score.mjs and is deterministic, so the WAV
# (18 MB) is a build product, not a source file.
audio/promo-score.wav

# The film itself. Attach it to a release; do not grow the pack with 20 MB of
# binary per re-render. The root .gitignore already covers `dist/`.
dist/
